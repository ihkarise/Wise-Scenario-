# Copy to .env.local for local development. Never commit real values.

# Where case content and attempts are stored.
#   memory   = built-in demo data, attempts kept in server memory (Milestone 1 default)
#   supabase = PostgreSQL via Supabase (repositories arrive in Milestone 2)
WISECASES_DATA_SOURCE=memory

# Supabase project settings (Milestone 2). Leave empty until the project exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
