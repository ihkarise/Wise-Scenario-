# Copy to .env.local (never committed). Only NEXT_PUBLIC_* values are sent to the browser.

# --- Supabase (public, safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only: never prefix with NEXT_PUBLIC_, never commit ---
# PostgreSQL connection string from Supabase → Connect → "Transaction pooler" (port 6543), with your DB password.
# The server needs it to check answers and save attempts (learners have no database access to either),
# and runs admin actions as the signed-in user so Row Level Security still applies.
DATABASE_URL=
# Random string (32+ characters) that signs guest cookies. Generate with: openssl rand -base64 48
WISECASES_SESSION_SECRET=
# Optional: max database connections per server instance (default 5).
# DATABASE_POOL_MAX=5
